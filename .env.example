# Ministros FC - Environment Configuration
# Copy this file to .env and update with your actual values

# ==============================================
# Environment Mode
# ==============================================
NODE_ENV=development

# ==============================================
# Database Configuration
# ==============================================
# PostgreSQL connection details
DB_HOST=db
DB_PORT=5100
DB_USER=ministros_user
DB_PASSWORD=ministros_password_dev
DB_NAME=ministrosfc

# Prisma ORM database URL (auto-constructed by podman-compose, but can override)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://ministros_user:ministros_password_dev@db:5100/ministrosfc

# ==============================================
# Redis Configuration (Optional)
# ==============================================
REDIS_HOST=redis
REDIS_PORT=5101
REDIS_PASSWORD=redis_password_dev
REDIS_URL=redis://:redis_password_dev@redis:5101

# ==============================================
# Backend (Nest.js CMS) Configuration
# ==============================================
API_HOST=0.0.0.0
API_PORT=5102

# API logging level: debug, info, warn, error
API_LOG_LEVEL=debug

# JWT Configuration (CHANGE THESE IN PRODUCTION!)
JWT_SECRET=your_jwt_secret_change_in_production_12345
JWT_EXPIRATION=24h

# CORS allowed origins (comma-separated)
CORS_ORIGIN=http://localhost:5103,http://frontend:5103,http://127.0.0.1:5103

# File upload directory
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880  # 5MB in bytes

# ==============================================
# Frontend (Nuxt 4) Configuration
# ==============================================
APP_HOST=0.0.0.0
APP_PORT=5103

# API endpoints
# API_URL is used server-side (internal container network)
API_URL=http://backend:5102/api

# API_URL_PUBLIC is used client-side (public access)
API_URL_PUBLIC=http://localhost:5102/api

# Public URL for the frontend (used for canonical URLs, etc)
PUBLIC_URL=http://localhost:5103

# ==============================================
# Email Configuration (Optional)
# ==============================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-email-password
SMTP_FROM=noreply@ministrosfc.local

# ==============================================
# Third-party Services (Optional)
# ==============================================
# AWS S3 for file uploads (if using instead of local filesystem)
# AWS_ACCESS_KEY_ID=your-key
# AWS_SECRET_ACCESS_KEY=your-secret
# AWS_S3_BUCKET=ministrosfc-uploads
# AWS_S3_REGION=eu-west-1

# Sentry for error tracking (if enabled)
# SENTRY_DSN=https://your-sentry-dsn

# ==============================================
# Development & Testing
# ==============================================
# Enable debug logging for development
DEBUG=app:*

# Database seeding (development only)
# SEED_DATABASE=false

# ============== IMPORTANT NOTES ==============
# 1. NEVER commit the .env file with real secrets to git
# 2. For production:
#    - Use strong random JWT_SECRET (min 32 chars)
#    - Use strong DB_PASSWORD
#    - Use strong REDIS_PASSWORD
#    - Set NODE_ENV=production
#    - Use HTTPS and set proper CORS_ORIGIN
#    - Use external database service (not containerized)
#    - Use external Redis service or Redis Cloud
#    - Enable security headers and HTTPS
# 3. For local development, the defaults here are safe
# 4. Generate a secure JWT secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
