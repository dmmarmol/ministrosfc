# Database
DATABASE_URL="postgresql://dev:dev123@localhost:5100/ministrosfc_dev?schema=public"

# JWT Authentication
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRY="24h"
REFRESH_TOKEN_EXPIRY="30d"

# Admin seed credentials (required by src/public/scripts/seed-admin.ts)
# In public repositories, never hardcode these values in source files or workflows.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-strong-admin-password"

# Redis
# ─────────────────────────────────────────────────────────────────────────────
# PRODUCTION (Fly.io + Upstash): set REDIS_URL as a single rediss:// connection
# string via `flyctl secrets set REDIS_URL=rediss://...`. The app reads this
# variable first and ignores REDIS_HOST/REDIS_PORT when it is present.
#
# Sign up at https://upstash.com → create a Redis database → copy the
# "Redis Connection String" (starts with rediss://). Free tier: 10K cmds/day.
#
REDIS_URL=""
#
# LOCAL DEVELOPMENT (Docker Compose): leave REDIS_URL empty and use the
# individual host/port vars below instead. The local Redis container runs on
# port 5101 (see docker-compose.yml).
REDIS_HOST="localhost"
REDIS_PORT=5101
REDIS_PASSWORD=""

# Validation rule:
# - Local development: provide REDIS_HOST + REDIS_PORT (REDIS_URL can stay empty)
# - Production: REDIS_URL is recommended/expected

# Server
NODE_ENV="development"
API_PORT=5102

# CORS (comma-separated list of allowed frontend origins)
# Override in .env.local to add extra dev origins, e.g.:
#   CORS_ORIGINS=http://localhost:5103,http://localhost.ministrosfc.com:5103
CORS_ORIGINS="http://localhost:5103"

# Frontend URL used by OAuth callback redirects from CMS
FRONTEND_URL="http://localhost:5103"

# Cloudinary (image storage)
# Sign up at https://cloudinary.com — free tier (25GB storage / 25GB bandwidth/month) is sufficient for MVP
# Dashboard → Settings → API Keys
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
# Validation rule:
# - Local development: optional (only required when testing image upload flows)
# - Production: required
#
# Alternative providers (not implemented — see packages/cms/src/utils/object-storage.ts for notes):
#   Cloudflare R2 : requires @aws-sdk/client-s3, env vars: R2_ENDPOINT, R2_BUCKET, R2_ACCESS_KEY, R2_SECRET_KEY
#   Supabase      : requires @supabase/supabase-js, env vars: SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_BUCKET

# Google OAuth (user registration via Google Sign-In)
# Setup: https://console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client ID (Web app)
# Authorized redirect URI: http://localhost:5102/api/v1/auth/google/callback
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:5102/api/v1/auth/google/callback"
