# API Configuration
NUXT_PUBLIC_API_BASE_URL="http://localhost:5102"

# Branding
NUXT_PUBLIC_BRAND_COLOR="#D4AF37"
NUXT_PUBLIC_TEAM_NAME="Ministros F.C."

# Environment
NODE_ENV="development"
NUXT_PORT=5103

# Dev server host binding
# Default: localhost (standard dev access via http://localhost:5103)
# Set to 0.0.0.0 in .env.local to also enable custom hostname access,
# e.g. http://localhost.ministrosfc.com:5103 (requires /etc/hosts entry)
NUXT_HOST=localhost
